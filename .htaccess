# Ustawienia serwera dla Hostingera (LiteSpeed/Apache). GitHub Pages ten plik ignoruje.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # strona jest wdrażana z repozytorium – katalog .git i inne ukryte pliki nie mogą być dostępne
  # (poza .well-known, którego używa certyfikat SSL)
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule ^README\.md$ - [F,L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # zdjęcia z panelu mają unikalne nazwy, więc mogą być długo trzymane w przeglądarce
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  # strona, produkty i dane logowania panelu zawsze świeże
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>
